# Copy to .env and fill in. Required for local app setup.
# Get values from Supabase: Settings > API (Project URL, Publishable API Key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-api-key-here

# Base URL for password reset links. Must match Supabase Auth > URL Configuration > Redirect URLs (e.g. http://localhost:8081 or https://your-app.com).
EXPO_PUBLIC_APP_URL=http://localhost:8081
