# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
workers/state-scrapers/website-verification-worker/tmp/

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# lib/mailbox build artifacts (output belongs in lib/mailbox/dist/)
lib/mailbox/*.js
lib/mailbox/*.js.map
lib/mailbox/*.d.ts
lib/mailbox/*.d.ts.map

# generated native folders
/ios
/android

# amplify
.amplify
amplify_outputs*
amplifyconfiguration*

# cursor
.cursor/debug*.log

# Client audit artifacts — never commit
docs/audit/
tmp/*

# lib/client-api/webhooks build artifacts
lib/client-api/webhooks/*.js
lib/client-api/webhooks/*.js.map
lib/client-api/webhooks/*.d.ts
lib/client-api/webhooks/*.d.ts.map

# scripts
scripts/lead-sourcing/