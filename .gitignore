# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
workers/state-scrapers/website-verification-worker/tmp/

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# lib/mailbox build artifacts (output belongs in lib/mailbox/dist/)
lib/mailbox/*.js
lib/mailbox/*.js.map
lib/mailbox/*.d.ts
lib/mailbox/*.d.ts.map

# generated native folders
/ios
/android

# amplify
.amplify
amplify_outputs*
amplifyconfiguration*

# cursor
.cursor/debug*.log

# Client audit artifacts — never commit
docs/audit/
tmp/*

# Client API docs site build artifacts (fumadocs / Next)
docs/client-api/.next/
docs/client-api/.source/
docs/client-api/out/
docs/client-api/node_modules/

# Client API docs — generated by export:client-api-docs (do not commit)
docs/client-api/content/docs/
docs/client-api/public/guides/
docs/client-api/public/concepts/
docs/client-api/public/webhooks/
docs/client-api/public/reference/
docs/client-api/public/openapi.json
docs/client-api/public/llms.txt
docs/client-api/public/llms-full.txt
docs/client-api/public/search-manifest.json
docs/client-api/public/index.md
docs/client-api/public/changelog.md

# lib/client-api/webhooks build artifacts
lib/client-api/webhooks/*.js
lib/client-api/webhooks/*.js.map
lib/client-api/webhooks/*.d.ts
lib/client-api/webhooks/*.d.ts.map

# Lead-sourcing scripts are tracked; keep run data and local dumps out of git.
# (node_modules/ and .env are already ignored globally.)
scripts/lead-sourcing/**/output/
scripts/lead-sourcing/**/data/
scripts/lead-sourcing/**/inputs/
scripts/lead-sourcing/**/src/*.csv
scripts/lead-sourcing/.cursor/