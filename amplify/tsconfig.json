{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "$amplify/*": [
        "../.amplify/generated/*"
      ],
      "@supabase/supabase-js": [
        "../node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../lib/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".amplify"
  ]
}