# You can keep this file, or put the same keys in the repo-root `.env.local` (FurnaceBuild/.env.local).
# `npm run deploy:dev` loads repo-root first, then this file. `DEV_SUPABASE_URL` can be omitted if
# `EXPO_PUBLIC_SUPABASE_URL` is set in the root file.

# AWS Configuration
CDK_DEFAULT_ACCOUNT=686255981838
CDK_DEFAULT_REGION=us-west-2

# Supabase Branch URLs
# Get these from Supabase Dashboard → Settings → API
DEV_SUPABASE_URL=https://your-project-ref-dev.supabase.co
PROD_SUPABASE_URL=https://your-project-ref.supabase.co

# Leads/registry Supabase (separate project). Same resolution pattern as main:
# - Set LEADS_SUPABASE_URL alone → used for WorkerStack-Dev (like EXPO_PUBLIC_SUPABASE_URL for main).
# - Or set DEV_LEADS_SUPABASE_URL / PROD_LEADS_SUPABASE_URL explicitly.
# - Aliases: LEADS_SUPABASE_URL_DEV, LEADS_SUPABASE_URL_PROD (like SUPABASE_URL_DEV / SUPABASE_URL_PROD).
# DEV_LEADS_SUPABASE_URL=https://your-leads-ref.supabase.co
# PROD_LEADS_SUPABASE_URL=https://your-leads-prod-ref.supabase.co

# Required for CDK synth/deploy: one SSM "folder" per environment (leading slash, no trailing secret name).
# Workers use: {prefix}/SUPABASE_SECRET_KEY and {prefix}/LEADS_SUPABASE_SECRET_KEY (Amplify layout).
# See docs/infrastructure/WORKER_SSM_AND_AMPLIFY_SECRETS.md
# WorkerStack-Prod is always synthesized; set PROD_* even for dev-only work (duplicate dev prefix if needed).
DEV_SECRET_SSM_PREFIX=/amplify/furnacebuild/your-sandbox-or-branch-id
PROD_SECRET_SSM_PREFIX=/amplify/shared/your-prod-shared-id

# Optional: Slack error reporting (different webhook per environment).
# Set both so dev and prod workers post to different channels.
# Used when you run deploy:dev vs deploy:prod (each stack gets its own URL).
# DEV_SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...  (dev channel)
# PROD_SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...  (prod channel)
# Fallback: SLACK_ERROR_WEBHOOK_URL is used for both if DEV_/PROD_ are not set.