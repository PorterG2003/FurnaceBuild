# AWS Configuration
CDK_DEFAULT_ACCOUNT=686255981838
CDK_DEFAULT_REGION=us-west-2

# Supabase Branch URLs
# Get these from Supabase Dashboard → Settings → API
DEV_SUPABASE_URL=https://your-project-ref-dev.supabase.co
PROD_SUPABASE_URL=https://your-project-ref.supabase.co

# Optional: SSM Parameter Store paths (have defaults in bin/workers.ts)
# DEV_SUPABASE_SECRET_KEY_PARAM_PATH=/amplify/furnacebuild/dev/SUPABASE_SECRET_KEY
# PROD_SUPABASE_SECRET_KEY_PARAM_PATH=/amplify/shared/d1jtp0rz0l9mcn/SUPABASE_SECRET_KEY

# Optional: Slack error reporting (different webhook per environment).
# Set both so dev and prod workers post to different channels.
# Used when you run deploy:dev vs deploy:prod (each stack gets its own URL).
# DEV_SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...  (dev channel)
# PROD_SLACK_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...  (prod channel)
# Fallback: SLACK_ERROR_WEBHOOK_URL is used for both if DEV_/PROD_ are not set.