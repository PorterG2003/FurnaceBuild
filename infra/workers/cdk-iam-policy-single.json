{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PowerUserAccess",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "s3:*",
        "ecs:*",
        "ecr:*",
        "ec2:*",
        "logs:*",
        "application-autoscaling:*",
        "autoscaling:*",
        "cloudwatch:*",
        "events:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMFullAccess",
      "Effect": "Allow",
      "Action": [
        "iam:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMReadSupabaseKeys",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:us-west-2:686255981838:parameter/amplify/*"
    },
    {
      "Sid": "STSGetCallerIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}


