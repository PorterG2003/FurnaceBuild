{
  "name": "furnace-workers-infra",
  "version": "1.0.0",
  "description": "CDK infrastructure for Furnace ECS workers (dev/prod)",
  "main": "lib/worker-stack.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "bash scripts/load-env.sh cdk",
    "bootstrap": "bash scripts/load-env.sh cdk bootstrap aws://${CDK_DEFAULT_ACCOUNT:-686255981838}/${CDK_DEFAULT_REGION:-us-west-2}",
    "deploy:dev": "bash scripts/load-env.sh cdk deploy WorkerStack-Dev",
    "deploy:prod": "bash scripts/load-env.sh cdk deploy WorkerStack-Prod",
    "deploy:all": "bash scripts/load-env.sh cdk deploy --all",
    "diff:dev": "bash scripts/load-env.sh cdk diff WorkerStack-Dev",
    "diff:prod": "bash scripts/load-env.sh cdk diff WorkerStack-Prod",
    "synth:dev": "bash scripts/load-env.sh cdk synth WorkerStack-Dev",
    "synth:prod": "bash scripts/load-env.sh cdk synth WorkerStack-Prod",
    "env:setup": "cp .env.example .env.local && echo '✅ Created .env.local - please edit it with your values'",
    "check:stack": "bash scripts/check-stack-status.sh",
    "check:services": "bash scripts/check-services.sh",
    "check:task": "bash scripts/check-task-details.sh",
    "check:logs": "bash scripts/check-logs.sh",
    "debug:container": "bash scripts/debug-container.sh",
    "cleanup:old": "bash scripts/cleanup-old-resources.sh",
    "delete:old-cluster": "bash scripts/delete-old-cluster.sh",
    "delete:old-logs": "bash scripts/delete-old-logs.sh",
    "apply:migrations": "bash scripts/apply-migrations.sh",
    "verify:migrations": "bash scripts/verify-migrations.sh",
    "check:env": "bash scripts/check-worker-env.sh",
    "test:url": "bash scripts/test-supabase-url.sh",
    "fix:vpc-dns": "bash scripts/fix-vpc-dns.sh",
    "check:vpc-dns": "bash scripts/check-vpc-dns.sh",
    "check:vpc-routes": "bash scripts/check-vpc-routes.sh",
    "check:branch": "bash scripts/check-supabase-branch.sh",
    "sync:dev": "bash scripts/sync-dev-from-main.sh",
    "cancel:stack": "bash scripts/cancel-stack.sh",
    "build:dev": "bash scripts/build-and-push.sh dev all",
    "build:dev:send": "bash scripts/build-and-push.sh dev send-worker",
    "build:dev:scheduler": "bash scripts/build-and-push.sh dev scheduler-worker",
    "build:dev:inbox-checker": "bash scripts/build-and-push.sh dev inbox-checker-worker",
    "build:dev:smartlead": "bash scripts/build-and-push.sh dev smartlead-migration-task",
    "build:prod": "bash scripts/build-and-push.sh prod all",
    "build:prod:send": "bash scripts/build-and-push.sh prod send-worker",
    "build:prod:scheduler": "bash scripts/build-and-push.sh prod scheduler-worker",
    "build:prod:inbox-checker": "bash scripts/build-and-push.sh prod inbox-checker-worker",
    "build:prod:smartlead": "bash scripts/build-and-push.sh prod smartlead-migration-task",
    "scale:dev": "bash scripts/scale-services.sh dev",
    "scale:prod": "bash scripts/scale-services.sh prod",
    "scale:down:dev": "bash scripts/scale-services.sh dev 0 0 0",
    "scale:down:prod": "bash scripts/scale-services.sh prod 0 0 0",
    "set-secret:dev": "bash scripts/set-supabase-secret.sh dev",
    "set-secret:prod": "bash scripts/set-supabase-secret.sh prod",
    "verify-secret:dev": "bash scripts/verify-secret.sh dev",
    "verify-secret:prod": "bash scripts/verify-secret.sh prod",
    "restart:dev": "bash scripts/restart-services.sh dev",
    "restart:prod": "bash scripts/restart-services.sh prod",
    "validate": "bash scripts/validate-build.sh",
    "validate:build": "bash scripts/validate-build.sh"
  },
  "keywords": [
    "cdk",
    "aws",
    "ecs",
    "workers"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.0"
  }
}

