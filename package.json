{
  "name": "furnacebuild",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir web-build",
    "generate:pwa-splash": "npx --yes pwa-asset-generator@6.4.0 assets/Logo_Color.svg public/pwa-splash --splash-only --favicon false --manifest false --path-override /pwa-splash --padding \"12%\" --background \"#121212\" && cp assets/Logo_Color.svg public/Logo_Color.svg",
    "validate": "bash scripts/validate-expo-build.sh",
    "validate:build": "bash scripts/validate-expo-build.sh",
    "verify:amplify-yml-installs": "node scripts/verify-amplify-yml-installs.mjs",
    "verify:email-parsing": "tsx scripts/verify-email-parsing.ts",
    "verify:google-ads-transparency": "tsx scripts/verify-google-ads-transparency.ts",
    "verify:google-ads-competitor-audit": "tsx scripts/verify-google-ads-competitor-audit.ts",
    "test:campaign:unit": "node --import tsx --test lib/inbox/quote-utils.test.ts lib/inbox/parseOutOfOfficeReturnDate.test.ts lib/inbox/outOfOfficeSchedule.test.ts lib/inbox/outOfOfficeResumeRules.test.ts lib/inbox/resolveReplyComposerTarget.test.ts lib/leads/replacementSummary.test.ts lib/test/campaign/productionLikeSeed.test.ts",
    "test:campaign:fixtures": "npm run test:campaign:unit",
    "test:campaign:integration": "node --test-concurrency=1 --import tsx --test lib/test/campaign/oooOutcomes.test.ts lib/test/campaign/waitTimeOutcomes.test.ts lib/test/campaign/schedulerOutcomes.test.ts lib/test/campaign/replacedLeadOutcomes.test.ts lib/test/campaign/throttleScheduleOutcomes.test.ts lib/test/campaign/campaignLifecycleOutcomes.test.ts",
    "test:campaign:worker": "npm test --prefix workers/scheduler-worker",
    "test:campaign": "npm run test:campaign:unit && npm run test:campaign:integration && npm run test:campaign:worker",
    "test:flux": "node --import tsx --test lib/flux/*.test.ts lib/flux/editor/*.test.ts",
    "test:foundry": "node --import tsx --test lib/foundry/parseCompanyDedupeTaskPayload.test.ts lib/foundry/parseEntityOwnerDedupeTaskPayload.test.ts && npm test --prefix lib/foundry/registry-server",
    "test:utilities": "node --import tsx --test lib/email/*.test.ts lib/slack/*.test.ts lib/account/*.test.ts lib/smartlead/migration.test.ts lib/supabase/services/campaigns/campaign-stats-by-day-rpc-map.test.ts",
    "test:send-worker": "npm test --prefix workers/send-worker",
    "test:inbox-checker": "npm test --prefix workers/inbox-checker-worker",
    "test:workers": "npm run test:send-worker && npm run test:inbox-checker",
    "test:scrapers": "npm test --prefix workers/state-scrapers/florida-scraper && npm test --prefix workers/state-scrapers/iowa-scraper && npm test --prefix workers/state-scrapers/utah-scraper && npm test --prefix workers/state-scrapers/google-ads-verification-worker",
    "test:core": "npm run test:campaign && npm run test:foundry",
    "test:seed:smoke": "npx tsx scripts/seed/index.ts --scenario=dev-default --dry-run && node --import tsx --test lib/test/campaign/productionLikeSeed.test.ts scripts/seed/constants/oooMixedInbox.runtime.test.ts",
    "migrate:users": "tsx scripts/migrate-cognito-users-to-supabase-auth.ts",
    "migrate:users:dry": "DRY_RUN=1 tsx scripts/migrate-cognito-users-to-supabase-auth.ts",
    "seed": "tsx scripts/seed/index.ts",
    "seed:reset": "tsx scripts/seed/reset.ts",
    "seed:wipe": "tsx scripts/seed/index.ts --wipe",
    "seed:help": "tsx scripts/seed/index.ts --help"
  },
  "dependencies": {
    "@10play/react-native-web-webview": "^0.0.3",
    "@10play/tentap-editor": "^1.0.1",
    "@aws-sdk/client-lambda": "^3.932.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-sfn": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@compwright/namecase": "^3.0.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@furnace/email-lib": "file:lib/email",
    "@furnace/slack-lib": "file:lib/slack",
    "@hello-pangea/dnd": "^18.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@supabase/supabase-js": "^2.99.1",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@xyflow/react": "^12.9.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "expo": "~54.0.25",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.3",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~18.0.6",
    "expo-font": "^14.0.9",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "^0.548.0",
    "nativewind": "^4.2.1",
    "papaparse": "^5.5.3",
    "planetary.js": "^1.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-canvas": "^0.1.40",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-heroicons": "^4.0.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.5.0",
    "reanimated-color-picker": "^4.2.0",
    "resend": "^6.4.2",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^3.4.18",
    "three": "^0.180.0",
    "topojson": "^3.0.2",
    "tw-merge": "^0.0.1-alpha.3",
    "twrnc": "^4.10.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.17.0",
    "@aws-amplify/backend-cli": "^1.8.0",
    "@aws-amplify/backend-deployer": "^2.1.3",
    "@aws-amplify/sandbox": "^2.1.2",
    "@types/node": "^24.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.1.0",
    "@types/react-native-canvas": "^0.1.14",
    "aws-cdk-lib": "^2.216.0",
    "babel-preset-expo": "^54.0.6",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0"
  },
  "private": true
}
