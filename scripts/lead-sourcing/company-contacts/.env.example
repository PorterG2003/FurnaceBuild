# Apollo.io — optional locally; auto-loaded from Amplify SSM via webinar-hosts ensureEnv
# APOLLO_SECRET_TARGET_ENV=dev
# APOLLO_API_KEY=

# MillionVerifier — optional locally; auto-loaded from Amplify SSM for verify-leads
# MILLION_VERIFIER_API_KEY=

# Hunter.io — domain search on Apollo rejects (SSM: HUNTER_API_KEY)
# HUNTER_API_KEY=

# Zero-cost fixture mode (no API key required)
USE_FIXTURES=0

# Optional caps
# MAX_APOLLO_CALLS=50
# MAX_ROWS=
