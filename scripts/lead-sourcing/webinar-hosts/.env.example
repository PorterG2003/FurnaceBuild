# Stage 1 — Google SERP via Serper (real Google index, tbs time filters, ~$0.001/search)
SERPER_API_KEY=
# SERPER_RATE_MS=500

# Stage 2 — LinkedIn (optional but strongly recommended)
LINKEDIN_LI_AT=

# Stages 3–4 — Apollo.io
# Optional locally — auto-loaded from Amplify SSM (dev sandbox first, then prod prefix)
# APOLLO_SECRET_TARGET_ENV=dev
APOLLO_API_KEY=

# Stage 3 — OpenRouter post analysis (optional)
OPENROUTER_API_KEY=

# Dev / debug
MAX_ROWS=
SAVE_RAW_HTML_DIR=

# Zero-cost fixture mode (no API keys required)
USE_FIXTURES=0

# Interrupted Stage 1 runs resume with: npm run stage1 -- --resume output/runs/<dir>

# Paid smoke test: requires SERPER_API_KEY, APOLLO_API_KEY, and optionally LINKEDIN_LI_AT
ALLOW_PAID_SMOKE=0
