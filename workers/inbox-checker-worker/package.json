{
  "name": "@furnace/inbox-checker-worker",
  "version": "1.0.0",
  "description": "Inbox checker worker for processing IMAP mailboxes",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "backfill:reparse": "tsx src/backfill-reparse.ts",
    "test": "npm --prefix ../../lib/mailbox run build && node --import tsx --test src/thread-manager.test.ts src/worker.test.ts src/message-processor.test.ts"
  },
  "dependencies": {
    "@furnace/mailbox-lib": "file:../../lib/mailbox",
    "@furnace/slack-lib": "file:../../lib/slack",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@supabase/supabase-js": "^2.77.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "p-limit": "^5.0.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.0.0"
  }
}