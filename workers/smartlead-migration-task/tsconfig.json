{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": [
    "src/**/*",
    "../../lib/smartlead/**/*",
    "../../lib/supabase/types/**/*"
  ],
  "exclude": ["node_modules"]
}
